    "# LGD Experiments — Visualization & Evaluation\n",
    "\n",
    "Loads precomputed results from `checkpoints_and_results/`, trains or loads the robust classifier, downloads the conditional model from HuggingFace, then produces all plots and the final results table.\n",
    "\n",
    "**No LGD / diffusion sampling is run here.**\n",
    "\n",
    "Directory layout expected:\n",
    "```\n",
    "MNIST/\n",
    "  checkpoints_and_results/\n",
    "    Uniform.pkl\n",
    "    Bimodal.pkl\n",
    "    Unimodal.pkl\n",
    "    robust_classifier.pth          ← created here if missing\n",
    "    MnistConditional500Epoch.pt    ← downloaded from HuggingFace if missing\n",
    "  src/\n",
    "    classifier.py\n",
    "    cond_model.py\n",
    "  notebooks/\n",
    "    visualization.ipynb            ← THIS FILE\n",
    "    plots/                         ← all output images saved here\n",
    "```"
   ]
  },

  {
   "cell_type": "markdown",
   "id": "md-1",
   "metadata": {},
   "source": [
    "## 1 · Paths & Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, sys, math, pickle\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import torch\n",
    "import pandas as pd\n",
    "\n",
    "# ── Path setup ────────────────────────────────────────────────────────────\n",
    "HERE      = os.path.abspath('')          # notebooks/\n",
    "MNIST_DIR = os.path.dirname(HERE)        # MNIST/\n",
    "SRC_DIR   = os.path.join(MNIST_DIR, 'src')\n",
    "CKPT_DIR  = os.path.join(MNIST_DIR, 'checkpoints_and_results')\n",
    "PLOTS_DIR = os.path.join(HERE, 'plots')\n",
    "\n",
    "for p in [SRC_DIR, MNIST_DIR]:\n",
    "    if p not in sys.path:\n",
    "        sys.path.insert(0, p)\n",
    "\n",
    "os.makedirs(PLOTS_DIR, exist_ok=True)\n",
    "\n",
    "device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "print(f'Device : {device}')\n",
    "print(f'CKPT   : {CKPT_DIR}')\n",
    "print(f'PLOTS  : {PLOTS_DIR}')"
   ]
  },

  {
   "cell_type": "markdown",
   "id": "md-2",
   "metadata": {},
   "source": [
    "## 2 · Load / Train Classifier"
   ]
  },
  {
   "cell_type": "code",
