   "source": [
    "from classifier import load_or_train_classifier\n",
    "\n",
    "CLF_PATH = os.path.join(CKPT_DIR, 'robust_classifier.pth')\n",
    "\n",
    "digit_classifier = load_or_train_classifier(\n",
    "    save_path  = CLF_PATH,\n",
    "    device     = device,\n",
    "    epochs     = 10,\n",
    "    batch_size = 128,\n",
    "    lr         = 1e-3,\n",
    "    seed       = 42,\n",
    ")"
   ]
  },

  {
   "cell_type": "markdown",
   "id": "md-3",
   "metadata": {},
   "source": [
    "## 3 · Load Conditional Model from HuggingFace"
