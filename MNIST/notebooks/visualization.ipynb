   "source": [
    "## 7 · Experiment 1 — Uniform\n",
    "### 7a · All images"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-7a",
   "metadata": {},
   "outputs": [],
   "source": [
    "plot_all_images(\n",
    "    payload_uniform, ncols=5, dpi=100,\n",
    "    save_path     = os.path.join(PLOTS_DIR, 'Uniform_all.png'),\n",
    "    save_no_title = True,\n",
    "    classifier    = digit_classifier,\n",
    "    device        = device,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "md-7b",
   "metadata": {},
   "source": [
    "### 7b · Top-5 images"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-7b",
   "metadata": {},
   "outputs": [],
   "source": [
    "top_ix_uniform = plot_top_k_images(\n",
    "    payload_uniform, top_k=5, dpi=100,\n",
    "    save_path     = os.path.join(PLOTS_DIR, 'Uniform_top5.png'),\n",
    "    save_no_title = True,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "md-7c",
   "metadata": {},
   "source": [
    "### 7c · Top-5 distributions"
